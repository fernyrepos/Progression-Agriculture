<?xml version="1.0" encoding="utf-8"?>
<Patch>
      <!-- <Operation Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>Defs/ThingDef[defName="AB_ShackledGamma"]/researchPrerequisites</xpath>
      </Operation> -->

      <Operation Class="PatchOperationFindMod">
          <mods>
              <li>Vanilla Factions Expanded - Medieval 2</li>
          </mods>
          <match Class="PatchOperationSequence">
              <operations>
                  <li Class="PatchOperationAdd">
                      <xpath>/Defs</xpath>
                      <value>
                          <ReplaceLib.ReplacerDef>
                              <defName>ProgressionAgriculture_AlphaBiomes_VFEMedieval2</defName>
                              <replacers>
                                  <li>
                                      <replace>AB_Glowstool</replace>
                                      <with>Glowstool</with>
                                  </li>
                              </replacers>
                          </ReplaceLib.ReplacerDef>
                      </value>
                  </li>

                  <li Class="PatchOperationReplace">
                      <xpath>Defs/BiomeDef[defName="AB_MycoticJungle"]/wildPlants/AB_Glowstool</xpath>
                      <value>
                          <Glowstool>3</Glowstool>
                      </value>
                  </li>
              </operations>
          </match>
      </Operation>
</Patch>
