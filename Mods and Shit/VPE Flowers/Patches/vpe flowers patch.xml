<?xml version="1.0" encoding="utf-8"?>
<Patch>
      <Operation Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>Defs/ResearchProjectDef[defName="VPEF_Horticulture"]/label</xpath>
          <value><label>Blooming cultivation</label></value>
      </Operation>

      <Operation Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>Defs/ResearchProjectDef[defName="VPEF_Horticulture"]/description</xpath>
          <value><description>Learn the techniques of caring for flowers during their blooming phase, allowing your colony to plant blooming flowers.</description></value>
      </Operation>
    
      <Operation Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>Defs/ResearchProjectDef[defName="VPEF_Horticulture"]/baseCost</xpath>
          <value><baseCost>200</baseCost></value>
      </Operation>
</Patch>